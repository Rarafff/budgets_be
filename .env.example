APP_ENV=development
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_PRIMARY_MODEL=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_CHEAP_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_RECEIPT_MODEL=inclusionai/ling-3.0-flash-vl:free
DATABASE_URL=postgresql://postgres:replace-with-your-password@db.your-project-ref.supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
MAX_REQUEST_BODY_BYTES=10485760
# Generate once with: go run ./cmd/vapid
VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
